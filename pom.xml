<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>
	<groupId>com.estudaenade</groupId>
	<artifactId>estuda-enade-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>estuda-enade-api</name>
	<description>API do Estuda ENADE: aluno (app e web) e portal do professor</description>

	<properties>
		<java.version>21</java.version>
		<jjwt.version>0.12.6</jjwt.version>
		<openapi-generator.version>7.27.0</openapi-generator.version>
		<springdoc.version>3.2.0</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!--
			Validação do ID token do Google (Nimbus + NimbusJwtDecoder). Só a biblioteca: o starter
			oauth2-resource-server não entra, porque configuraria um segundo filtro de JWT.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>
		<!-- Envio do código de redefinição de senha por e-mail (otp.provider=smtp) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Swagger UI: mostra o contrato de src/main/resources/static/openapi -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Testes -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Contrato primeiro: o arquivo OpenAPI é a fonte da API. A cada build este plugin gera, em
				target/generated-sources/openapi, as interfaces que os controllers implementam (api.contrato)
				e as classes de requisição (api.contrato.dto). Não edite o código gerado: altere o JSON do contrato.
			-->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/static/openapi/estuda-enade-api.json</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.estudaenade.api.api.contrato</apiPackage>
							<modelPackage>com.estudaenade.api.api.contrato.dto</modelPackage>
							<generateSupportingFiles>false</generateSupportingFiles>
							<generateApiTests>false</generateApiTests>
							<generateModelTests>false</generateModelTests>
							<generateApiDocumentation>false</generateApiDocumentation>
							<generateModelDocumentation>false</generateModelDocumentation>
							<configOptions>
								<interfaceOnly>true</interfaceOnly>
								<skipDefaultInterface>true</skipDefaultInterface>
								<useSpringBoot3>true</useSpringBoot3>
								<useTags>true</useTags>
								<useResponseEntity>false</useResponseEntity>
								<requestMappingMode>none</requestMappingMode>
								<useBeanValidation>true</useBeanValidation>
								<openApiNullable>false</openApiNullable>
								<documentationProvider>none</documentationProvider>
								<annotationLibrary>none</annotationLibrary>
								<hideGenerationTimestamp>true</hideGenerationTimestamp>
							</configOptions>
							<!--
								Respostas e enums não são gerados: o contrato os descreve, mas o código usa os
								records de api/dto e os enums do domínio. O ContratoOpenApiTest confere que os
								campos dos records batem com os do contrato.
							-->
							<schemaMappings>
								<schemaMapping>Papel=com.estudaenade.api.domain.enums.Papel</schemaMapping>
								<schemaMapping>TipoAtividade=com.estudaenade.api.domain.enums.TipoAtividade</schemaMapping>
								<schemaMapping>StatusAtividade=com.estudaenade.api.domain.enums.StatusAtividade</schemaMapping>
								<schemaMapping>StatusQuestao=com.estudaenade.api.domain.enums.StatusQuestao</schemaMapping>
								<schemaMapping>Encerramento=com.estudaenade.api.domain.enums.Encerramento</schemaMapping>
								<schemaMapping>ErroResponse=com.estudaenade.api.exception.GlobalExceptionHandler.ErroResponse</schemaMapping>
								<schemaMapping>ItemResponse=com.estudaenade.api.api.dto.ItemResponse</schemaMapping>
								<schemaMapping>PaginaQuestaoResponse=com.estudaenade.api.api.dto.Pagina&lt;com.estudaenade.api.api.dto.QuestaoDtos.QuestaoResponse&gt;</schemaMapping>
								<schemaMapping>PaginaQuestaoAlunoResponse=com.estudaenade.api.api.dto.Pagina&lt;com.estudaenade.api.api.dto.QuestaoDtos.QuestaoAlunoResponse&gt;</schemaMapping>
								<schemaMapping>UsuarioResponse=com.estudaenade.api.api.dto.AuthDtos.UsuarioResponse</schemaMapping>
								<schemaMapping>SessaoResponse=com.estudaenade.api.api.dto.AuthDtos.SessaoResponse</schemaMapping>
								<schemaMapping>ProfessorPendenteResponse=com.estudaenade.api.api.dto.CadastroProfessorDtos.ProfessorPendenteResponse</schemaMapping>
								<schemaMapping>ConviteCriadoResponse=com.estudaenade.api.api.dto.CadastroProfessorDtos.ConviteCriadoResponse</schemaMapping>
								<schemaMapping>ConviteResponse=com.estudaenade.api.api.dto.CadastroProfessorDtos.ConviteResponse</schemaMapping>
								<schemaMapping>TurmaResponse=com.estudaenade.api.api.dto.TurmaDtos.TurmaResponse</schemaMapping>
								<schemaMapping>AlunoResponse=com.estudaenade.api.api.dto.TurmaDtos.AlunoResponse</schemaMapping>
								<schemaMapping>TurmaDetalheResponse=com.estudaenade.api.api.dto.TurmaDtos.TurmaDetalheResponse</schemaMapping>
								<schemaMapping>TurmaAlunoResponse=com.estudaenade.api.api.dto.TurmaDtos.TurmaAlunoResponse</schemaMapping>
								<schemaMapping>AlternativaResponse=com.estudaenade.api.api.dto.QuestaoDtos.AlternativaResponse</schemaMapping>
								<schemaMapping>QuestaoResponse=com.estudaenade.api.api.dto.QuestaoDtos.QuestaoResponse</schemaMapping>
								<schemaMapping>SinalizacaoResponse=com.estudaenade.api.api.dto.QuestaoDtos.SinalizacaoResponse</schemaMapping>
								<schemaMapping>AlternativaAlunoResponse=com.estudaenade.api.api.dto.QuestaoDtos.AlternativaAlunoResponse</schemaMapping>
								<schemaMapping>QuestaoAlunoResponse=com.estudaenade.api.api.dto.QuestaoDtos.QuestaoAlunoResponse</schemaMapping>
								<schemaMapping>GabaritoResponse=com.estudaenade.api.api.dto.QuestaoDtos.GabaritoResponse</schemaMapping>
								<schemaMapping>AtividadeResponse=com.estudaenade.api.api.dto.AtividadeDtos.AtividadeResponse</schemaMapping>
								<schemaMapping>AtividadeDetalheResponse=com.estudaenade.api.api.dto.AtividadeDtos.AtividadeDetalheResponse</schemaMapping>
								<schemaMapping>AtividadeAlunoResponse=com.estudaenade.api.api.dto.AtividadeDtos.AtividadeAlunoResponse</schemaMapping>
								<schemaMapping>TentativaEstadoResponse=com.estudaenade.api.api.dto.AtividadeDtos.TentativaEstadoResponse</schemaMapping>
								<schemaMapping>TentativaResumoResponse=com.estudaenade.api.api.dto.AtividadeDtos.TentativaResumoResponse</schemaMapping>
								<schemaMapping>QuestaoCorrigidaResponse=com.estudaenade.api.api.dto.AtividadeDtos.QuestaoCorrigidaResponse</schemaMapping>
								<schemaMapping>ResultadoTentativaResponse=com.estudaenade.api.api.dto.AtividadeDtos.ResultadoTentativaResponse</schemaMapping>
								<schemaMapping>TemaDesempenho=com.estudaenade.api.api.dto.DesempenhoDtos.TemaDesempenho</schemaMapping>
								<schemaMapping>DesempenhoAlunoResponse=com.estudaenade.api.api.dto.DesempenhoDtos.DesempenhoAlunoResponse</schemaMapping>
								<schemaMapping>AtividadeRecente=com.estudaenade.api.api.dto.DesempenhoDtos.AtividadeRecente</schemaMapping>
								<schemaMapping>ResumoTurmaResponse=com.estudaenade.api.api.dto.DesempenhoDtos.ResumoTurmaResponse</schemaMapping>
								<schemaMapping>PainelTurma=com.estudaenade.api.api.dto.DesempenhoDtos.PainelTurma</schemaMapping>
								<schemaMapping>AtividadeRecentePainel=com.estudaenade.api.api.dto.DesempenhoDtos.AtividadeRecentePainel</schemaMapping>
								<schemaMapping>PainelProfessorResponse=com.estudaenade.api.api.dto.DesempenhoDtos.PainelProfessorResponse</schemaMapping>
								<schemaMapping>ResultadoAluno=com.estudaenade.api.api.dto.DesempenhoDtos.ResultadoAluno</schemaMapping>
								<schemaMapping>ComentarioResponse=com.estudaenade.api.api.dto.ComentarioDtos.ComentarioResponse</schemaMapping>
								<schemaMapping>MuralResponse=com.estudaenade.api.api.dto.ComentarioDtos.MuralResponse</schemaMapping>
								<schemaMapping>ResultadosAtividadeResponse=com.estudaenade.api.api.dto.DesempenhoDtos.ResultadosAtividadeResponse</schemaMapping>
								<schemaMapping>DesempenhoAlunoTurmaResponse=com.estudaenade.api.api.dto.DesempenhoDtos.DesempenhoAlunoTurmaResponse</schemaMapping>
							</schemaMappings>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
